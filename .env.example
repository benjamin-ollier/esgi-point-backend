# Votre Clé API Developer (générée dans l'espace développeur Klyb)
KLYB_API_KEY=sk_live_rhu70fvxqekodi2j90ohdm

# Base de données
# Remplacez cette URL par celle de votre base PostgreSQL (ex: Supabase, Neon, etc.)
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# URL de l'API Klyb (en local : http://localhost:3000/api, en prod : https://api.klyb.co/api)
KLYB_API_URL=http://localhost:3000/api

# L'ID de votre widget tel qu'enregistré sur la plateforme Klyb
WIDGET_ID=your_widget_id_here

# Port d'écoute de ce micro-service (optionnel, pour exposer un endpoint de santé)
PORT=4000
